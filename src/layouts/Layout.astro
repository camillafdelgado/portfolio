---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import phaseScript from '../scripts/phase.js?raw';
import '../styles/global.css';

interface Props {
	title?: string;
	/** Homepage only: set the time-of-day phase before first paint. */
	timeOfDay?: boolean;
}

const { title = 'Camilla Delgado', timeOfDay = false } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{timeOfDay && <script is:inline set:html={phaseScript} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Geist:ital,wght@0,400;1,400&family=IBM+Plex+Mono:wght@400&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot name="backdrop" />
		<Nav timeOfDay={timeOfDay} />
		<slot />
		<Footer />
	</body>
</html>
