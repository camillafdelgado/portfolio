---
import Analytics from '@vercel/analytics/astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';

interface Props {
	title?: string;
	/** Show the site header (name, links, clock). Case studies hide it. */
	header?: boolean;
	/** Title on link previews (LinkedIn, iMessage, Slack); defaults to the page title. */
	shareTitle?: string;
	description?: string;
}

const {
	title = 'Camilla Delgado',
	header = true,
	shareTitle = title,
	description = 'Camilla is a product designer who makes complex systems easy to use. Interested in AI, design systems, and fun interactions.',
} = Astro.props;

// Link previews: a screenshot of the homepage at 1200×630, saved at 2× (public/og.jpg).
// Without the trailing slash, matching the site's own links (/washington-211).
const pageUrl = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site);
const shareImage = new URL('/og.jpg', Astro.site);

// LAUNCH: while true, search engines are asked not to index the site (used
// while camilladelgado.com still pointed at Framer). Launched: false.
const PRELAUNCH = false;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Fonts load without blocking first paint (text shows in the fallback,
		     then swaps); the noscript copy covers browsers without JS. -->
		<link
			rel="preload"
			as="style"
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Geist:ital,wght@0,400;1,400&display=swap"
			onload="this.onload=null;this.rel='stylesheet'"
		/>
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Geist:ital,wght@0,400;1,400&display=swap" /></noscript>
		{PRELAUNCH && <meta name="robots" content="noindex, nofollow" />}
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={pageUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Camilla Delgado" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:title" content={shareTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={shareImage} />
		<meta property="og:image:width" content="2400" />
		<meta property="og:image:height" content="1260" />
		<meta property="og:image:alt" content="Camilla Delgado's portfolio: Camilla is a product designer who makes complex systems easy to use." />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<slot name="backdrop" />
		{header && <Nav />}
		<slot />
		<Footer />
		<!-- Vercel Speed Insights: a small deferred script, no framework. -->
		<SpeedInsights />
		<!-- Page views for Vercel Analytics (only reports on Vercel deployments) -->
		<Analytics />
	</body>
</html>
