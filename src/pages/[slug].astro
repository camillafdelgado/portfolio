---
// One page per case study in src/content/work/ (e.g. /washington-211).
import { getCollection, render } from 'astro:content';
import CaseStudy from '../layouts/CaseStudy.astro';

export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Side nav: one link per top-level section label (<p class="label"> at the
// start of a line; labels nested in callouts or the insights grid are skipped).
const slug = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const sections = [...(entry.body ?? '').matchAll(/^<p class="label">(.+?)<\/p>/gm)].map(([, label]) => ({
	id: slug(label),
	label,
}));
---

<CaseStudy {...entry.data} sections={sections}>
	<Content />
</CaseStudy>
