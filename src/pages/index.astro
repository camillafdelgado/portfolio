---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Sky from '../components/Sky.astro';
import HeroScene from '../components/HeroScene.astro';
---

<Layout>
	<Sky slot="backdrop" />
	<main class="container">
		<!-- The hero is a full-width night band: Seattle skyline, rain and stars (HeroScene). -->
		<section class="hero">
			<HeroScene />
			<h1 class="hero-title">
				Camilla is a product designer who makes complex systems easy to use.{' '}
				<span class="muted-large">Interested in AI, design systems, and fun interactions.</span>
			</h1>

			<dl class="facts">
				<div>
					<dt class="label">Currently</dt>
					<dd>MS Human-Centered Design &amp; Engineering @ UW</dd>
				</div>
				<div>
					<dt class="label">Previously</dt>
					<dd>WA211, Ogilvy</dd>
				</div>
			</dl>
		</section>

		<section class="projects" aria-label="Projects">
			<ProjectCard
				href="/washington-211"
				title="Improving Washington 211’s search engine"
				status="Shipped"
				meta={['UX Design', 'Usability Test', '2026']}
			>
				<video
					class="lazy-video"
					src="/projects/wa211.mp4"
					poster="/projects/wa211-poster.webp"
					muted
					loop
					playsinline
					preload="none"
					width="1864"
					height="900"
					aria-label="Walkthrough of the Washington 211 search redesign"
				></video>
			</ProjectCard>

			<ProjectCard
				href="/sweet-and-sour"
				title="AI companion for death and legacy topics"
				status="Concept"
				meta={['End-to-End', 'Concept', '2025']}
			>
				<video
					class="lazy-video"
					src="/projects/companion.mp4"
					poster="/projects/companion-poster.webp"
					muted
					loop
					playsinline
					preload="none"
					width="1864"
					height="900"
					aria-label="Walkthrough of the Sweet & Sour practice chat: the AI writes a conversation script and the user saves it"
				></video>
			</ProjectCard>
		</section>
	</main>
</Layout>

<script>
	// Lazy videos: nothing downloads until a card is near the viewport; it plays
	// while visible and pauses offscreen. Reduced motion keeps the poster.
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
	const lazyVideos = new IntersectionObserver(
		(entries) => {
			for (const { target, isIntersecting } of entries) {
				const video = target as HTMLVideoElement;
				if (isIntersecting && !reduceMotion.matches) video.play().catch(() => {});
				else video.pause();
			}
		},
		{ rootMargin: '200px 0px' },
	);
	document.querySelectorAll('video.lazy-video').forEach((video) => lazyVideos.observe(video));
</script>

<style>
	/* Hero card — from Figma "home" (182:555). */
	.hero {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		gap: 60px;
		margin-top: 140px;
		/* Full bleed: break out of the container's gutters to the screen edges,
		   with the text kept in line with the rest of the page. No border,
		   corners or shadow, so it reads as a band rather than a clickable card. */
		margin-inline: calc(-1 * var(--gutter));
		padding: 64px var(--gutter);
		overflow: hidden;
		background: #191b20;
		color-scheme: dark;
		/* Night text colors, scoped to the band (the page around it is light).
		   Checked (WCAG AA) against the lightest part of the sky behind text. */
		--color-text: #d4d5da;
		--color-heading: #f3f3f5;
		--color-muted: #a9adbf;
		--color-muted-large: #8a90a8;
		--color-accent: #e3a6c2;
		color: var(--color-text);
	}

	/* The night sky: an indigo horizon at the bottom-center fading out to deep
	   navy at the edges, laid over the card at low strength so text stays readable. */
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(
			ellipse 59% 84% at var(--sun-x, 50%) 100%, /* follows the moon (HeroScene) */
			#3b4fb0 0%,
			#222b66 50%,
			#151a38 100%
		);
		opacity: 0.45;
	}

	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		margin: 0;
	}

	.facts div {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 356px;
	}

	.facts div:last-child {
		min-width: 0;
	}

	dd {
		margin: 0;
	}

	/* Project cards: two per row with a 24px gap (one per row on phones). */
	.projects {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
		padding-block: 80px 120px;
	}

	/* Narrow cards: room along the bottom for the little Seattle skyline. */
	@media (max-width: 900px) {
		.hero {
			padding-bottom: 130px;
		}
	}

	@media (max-width: 640px) {
		.hero {
			margin-top: 64px;
			padding: 32px var(--gutter) 130px; /* bottom room for the skyline */
			gap: 32px;
		}
		.hero-title {
			font-size: 28px;
		}
		.facts div {
			min-width: 0;
		}
		.projects {
			grid-template-columns: minmax(0, 1fr);
			padding-block: 64px 80px;
		}
	}
</style>
