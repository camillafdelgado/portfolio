---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Sky from '../components/Sky.astro';
import HeroScene from '../components/HeroScene.astro';
---

<Layout timeOfDay>
	<Sky slot="backdrop" />
	<main class="container">
		<!-- The hero card holds the time-of-day sky (colors from sky.css). -->
		<section class="hero">
			<HeroScene />
			<h1 class="hero-title">
				Camilla is a product designer who makes complex systems easy to use.{' '}
				<span class="muted-large">AI, design systems, and fun interactions.</span>
			</h1>

			<dl class="facts">
				<div>
					<dt class="label">Currently</dt>
					<dd>MS Human-Centered Design &amp; Engineering @ UW</dd>
				</div>
				<div>
					<dt class="label">Previously</dt>
					<dd>WA211, Ogilvy</dd>
				</div>
			</dl>
		</section>

		<section class="projects" aria-label="Projects">
			<ProjectCard
				href="/washington-211"
				title="Improving Washington 211’s search engine"
				status="Shipped"
				meta={['UX Design', 'Usability Test', '2026']}
			>
				<video
					src="/projects/wa211.mp4"
					poster="/projects/wa211-poster.jpg"
					autoplay
					muted
					loop
					playsinline
					aria-label="Walkthrough of the Washington 211 search redesign"
				></video>
			</ProjectCard>

			<ProjectCard
				href="/sweet-and-sour"
				title="AI companion for death and legacy topics"
				status="Concept"
				meta={['End-to-End', 'Concept', '2025']}
				background="#fafaf8"
			>
				<img
					class="phone"
					src="/projects/companion.gif"
					alt="Phone screens of the AI companion app"
					width="688"
					height="1394"
					loading="lazy"
				/>
			</ProjectCard>
		</section>
	</main>
</Layout>

<style>
	/* Hero card — from Figma "home" (182:555). */
	.hero {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		gap: 60px;
		margin-top: 140px;
		padding: 48px;
		overflow: hidden;
		border: 1px solid var(--color-card-border);
		border-radius: 16px;
		background: var(--color-card);
		box-shadow: 0 4px 20px 4px rgb(64 64 64 / 0.05);
		transition:
			background-color 3s ease,
			border-color 3s ease;
	}

	/* The sky: a warm horizon at the bottom-center fading out to the sky color at
	   the edges, laid over the card at low strength so text stays readable. */
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(
			ellipse 59% 84% at var(--sun-x, 50%) 100%, /* follows the sun (HeroScene) */
			var(--sky-glow) 0%,
			var(--sky-mid) 50%,
			var(--sky-top) 100%
		);
		opacity: var(--sky-strength);
		transition:
			--sky-top 3s ease,
			--sky-mid 3s ease,
			--sky-glow 3s ease,
			opacity 3s ease;
	}

	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		margin: 0;
	}

	.facts div {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 356px;
	}

	.facts div:last-child {
		min-width: 0;
	}

	dd {
		margin: 0;
	}

	.projects {
		display: flex;
		flex-direction: column;
		gap: 120px;
		padding-block: 80px 120px;
	}

	/* The companion card shows one phone, centered on its background. */
	.projects .phone {
		width: auto;
		height: 83%;
		margin: 4% auto 0;
		border-radius: 12px;
	}

	/* Narrow cards: room along the bottom for the little Seattle skyline. */
	@media (max-width: 900px) {
		.hero {
			padding-bottom: 130px;
		}
	}

	@media (max-width: 640px) {
		.hero {
			margin-top: 64px;
			padding: 24px 24px 130px; /* bottom room for the skyline */
			gap: 32px;
		}
		.hero-title {
			font-size: 28px;
		}
		.facts div {
			min-width: 0;
		}
		.projects {
			gap: 64px;
			padding-block: 64px 80px;
		}
	}
</style>
