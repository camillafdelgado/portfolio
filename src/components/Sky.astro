---
/**
 * Homepage time-of-day layer: loads the phase colors (sky.css, used by the
 * hero card in index.astro) and draws the full-page ASCII field, fixed behind
 * everything so the hero card and project cards cover it.
 */
import '../styles/sky.css';
---

<canvas class="ascii" aria-hidden="true" data-sky-ascii></canvas>

<style>
	/* Fixed to the screen, behind the content: text and cards scroll over it. */
	.ascii {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		pointer-events: none;
	}

	:global(body) {
		isolation: isolate;
	}
</style>

<script>
	// Full-page ASCII field, like the Claude Code start screen: faint, tightly
	// packed letters and numbers in soft diagonal streaks. The streaks stay put
	// (same spots on every visit); waves of characters re-shuffle through them and
	// they gently brighten and dim. Fixed behind the page; never drawn on text.
	// ~30fps, still for reduced motion.
	const canvas = document.querySelector<HTMLCanvasElement>('[data-sky-ascii]')!;
	const ctx = canvas.getContext('2d')!;

	const CHARS = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
	const FONT_SIZE = 11;
	const CELL_H = 15;
	let CELL_W = 6.6; // replaced by the real DM Mono character width once fonts load
	const FRAME_MS = 1000 / 30;
	const MAX_ALPHA = 0.2;
	// Characters change in waves: a front sweeps diagonally every WAVE_LEN px.
	const WAVE_LEN = 90;
	const WAVE_RATE = 1.6; // fronts per second passing any one spot
	const WAVE_DIR = { x: 0.5, y: 0.87 };
	const AVOID =
		'header .name, header nav a, header .time, .hero h1, .hero dl, .card .title, .card .meta';
	const AVOID_PAD = 16;
	const FEATHER = 5; // cells over which glyphs fade in next to text

	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');


	let w = 0;
	let h = 0;
	let cols = 0;
	let rows = 0;
	let jitter = new Float32Array(0); // per-cell offset so wave fronts look ragged
	let near = new Uint8Array(0); // distance (in cells) to the nearest text, capped
	let rgb = '64, 64, 64';
	let running = false;
	let last = 0;

	// Long, thin, slanted streaks rooted in fixed spots on the screen.
	// x/y/len/wid are fractions of the screen; angle is from vertical (radians);
	// breathe is how fast (per second) the streak brightens and dims.
	const streaks = [
		{ x: 0.08, y: 0.22, len: 0.22, wid: 0.06, angle: -0.35, breathe: 0.12, p: 0 },
		{ x: 0.3, y: 0.62, len: 0.3, wid: 0.05, angle: 0.55, breathe: 0.1, p: 2.1 },
		{ x: 0.62, y: 0.82, len: 0.28, wid: 0.05, angle: 0.65, breathe: 0.14, p: 4.2 },
		{ x: 0.93, y: 0.6, len: 0.2, wid: 0.04, angle: -0.25, breathe: 0.11, p: 1.3 },
		{ x: 0.84, y: 0.12, len: 0.16, wid: 0.04, angle: 0.4, breathe: 0.13, p: 3.4 },
	];

	// Cheap integer hash → which character a cell shows during wave number k.
	function charAt(i: number, k: number) {
		let x = Math.imul(i, 374761393) + Math.imul(k, 668265263);
		x = Math.imul(x ^ (x >>> 13), 1274126177);
		return ((x ^ (x >>> 16)) >>> 0) % CHARS.length;
	}


	function readColor() {
		rgb = getComputedStyle(document.documentElement).getPropertyValue('--ascii-rgb').trim() || rgb;
	}

	function measure() {
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		w = window.innerWidth;
		h = window.innerHeight;
		canvas.width = Math.round(w * dpr);
		canvas.height = Math.round(h * dpr);
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		ctx.font = `${FONT_SIZE}px "DM Mono", ui-monospace, monospace`;
		ctx.textBaseline = 'top';
		CELL_W = ctx.measureText('M').width;

		cols = Math.ceil(w / CELL_W);
		rows = Math.ceil(h / CELL_H);
		// Seeded (not random) so the pattern looks the same on every visit.
		jitter = new Float32Array(cols * rows).map((_, i) => (charAt(i, -1) / CHARS.length) * 0.7);
		near = new Uint8Array(cols * rows);
	}

	// Text moves as you scroll, so work out where it is on every frame.
	// near[i] = 0 on text, rising to FEATHER a few cells away (two-pass distance).
	function markText() {
		near.fill(FEATHER);
		document.querySelectorAll(AVOID).forEach((el) => {
			const r = el.getBoundingClientRect();
			if (r.bottom < -AVOID_PAD || r.top > h + AVOID_PAD) return;
			const c0 = Math.max(0, Math.floor((r.left - AVOID_PAD) / CELL_W));
			const c1 = Math.min(cols - 1, Math.floor((r.right + AVOID_PAD) / CELL_W));
			const r0 = Math.max(0, Math.floor((r.top - AVOID_PAD) / CELL_H));
			const r1 = Math.min(rows - 1, Math.floor((r.bottom + AVOID_PAD) / CELL_H));
			for (let y = r0; y <= r1; y++) near.fill(0, y * cols + c0, y * cols + c1 + 1);
		});
		for (let y = 0; y < rows; y++)
			for (let x = 0; x < cols; x++) {
				const i = y * cols + x;
				if (x > 0) near[i] = Math.min(near[i], near[i - 1] + 1);
				if (y > 0) near[i] = Math.min(near[i], near[i - cols] + 1);
			}
		for (let y = rows - 1; y >= 0; y--)
			for (let x = cols - 1; x >= 0; x--) {
				const i = y * cols + x;
				if (x < cols - 1) near[i] = Math.min(near[i], near[i + 1] + 1);
				if (y < rows - 1) near[i] = Math.min(near[i], near[i + cols] + 1);
			}
	}

	function draw(t: number) {
		ctx.clearRect(0, 0, w, h);
		markText();
		const s = t / 1000;
		const size = Math.max(w, h);

		const shapes = streaks.map((b) => {
			const sin = Math.sin(b.angle);
			const cos = Math.cos(b.angle);
			return {
				x: b.x * w,
				y: b.y * h,
				cos,
				sin,
				len2: (b.len * size) ** 2,
				wid2: (b.wid * size) ** 2,
				// 0.7–1: streaks gently brighten and dim, never vanish
				glow: 0.85 + 0.15 * Math.sin(s * b.breathe * 2 * Math.PI + b.p),
			};
		});

		for (let y = 0; y < rows; y++) {
			const py = y * CELL_H;
			for (let x = 0; x < cols; x++) {
				const i = y * cols + x;
				if (near[i] === 0) continue;
				const px = x * CELL_W;
				let d = 0;
				for (const c of shapes) {
					const dx = px - c.x;
					const dy = py - c.y;
					const along = dx * c.sin + dy * c.cos; // along the streak
					const across = dx * c.cos - dy * c.sin; // across it
					d += c.glow * Math.exp(-(along * along) / c.len2 - (across * across) / c.wid2);
				}
				// Soft threshold: nothing in the gaps, characters fade in at the edges.
				d = Math.min(1, Math.max(0, (d - 0.25) / 0.6)) * (near[i] / FEATHER);
				if (d < 0.04) continue;

				const k = Math.floor((px * WAVE_DIR.x + py * WAVE_DIR.y) / WAVE_LEN - s * WAVE_RATE + jitter[i]);
				ctx.fillStyle = `rgba(${rgb}, ${(d * MAX_ALPHA).toFixed(3)})`;
				ctx.fillText(CHARS[charAt(i, k)], px, py);
			}
		}

	}

	function loop(t: number) {
		if (!running) return;
		if (t - last >= FRAME_MS) {
			last = t - ((t - last) % FRAME_MS);
			draw(t);
		}
		requestAnimationFrame(loop);
	}

	function update() {
		const shouldRun = !document.hidden && !reduceMotion.matches;
		if (shouldRun && !running) {
			running = true;
			requestAnimationFrame(loop);
		} else if (!shouldRun) {
			running = false;
			draw(performance.now()); // leave a still frame
		}
	}

	// Redraw right away on scroll so text never passes over glyphs between frames.
	let scrollQueued = false;
	window.addEventListener(
		'scroll',
		() => {
			if (scrollQueued) return;
			scrollQueued = true;
			requestAnimationFrame((t) => {
				scrollQueued = false;
				draw(running ? t : performance.now());
			});
		},
		{ passive: true },
	);

	document.addEventListener('visibilitychange', update);
	reduceMotion.addEventListener('change', update);

	let resizeTimer: number;
	window.addEventListener('resize', () => {
		clearTimeout(resizeTimer);
		resizeTimer = window.setTimeout(() => {
			measure();
			draw(performance.now());
		}, 150);
	});

	// Follow phase changes (re-checked every minute, or forced via ?phase=).
	new MutationObserver(() => {
		readColor();
		if (!running) draw(performance.now());
	}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-phase'] });
	setInterval(() => (window as any).__sky?.apply(), 60_000);

	// Wait for DM Sans/Mono so the text positions we avoid are final.
	document.fonts.ready.then(() => {
		readColor();
		measure();
		draw(performance.now());
		update();
	});
</script>
