---
/**
 * Time-of-day theme menu (homepage nav, next to the clock).
 * Automatic follows Seattle's sun; Off turns the effect off; or pick a phase.
 * The button's pixel icon shows the phase on screen. The choice is saved per
 * visitor by src/scripts/phase.js (window.__sky).
 */

// 12×12 pixel icons ('#' = pixel), drawn crisp to match the scene.
const ICONS: Record<string, string[]> = {
	auto: [
		'   ######   ',
		'  #      #  ',
		' #   ##   # ',
		'#    ##    #',
		'#    ##    #',
		'#    ####  #',
		'#          #',
		'#          #',
		' #        # ',
		'  #      #  ',
		'   ######   ',
		'            ',
	],
	off: [
		'   ######   ',
		'  #      #  ',
		' #      ## #',
		'#      ##  #',
		'#     ##   #',
		'#    ##    #',
		'#   ##     #',
		'#  ##      #',
		' ##       # ',
		'  #      #  ',
		'   ######   ',
		'            ',
	],
	predawn: [
		'     #      ',
		'    ###     ',
		'     #      ',
		'         #  ',
		' #          ',
		'           #',
		'  #     ### ',
		' ###     #  ',
		'  #         ',
		'            ',
		'############',
		'            ',
	],
	sunrise: [
		'     ##     ',
		'  #  ##  #  ',
		'   #    #   ',
		'            ',
		'    ####    ',
		'#  ######  #',
		'  ########  ',
		' ########## ',
		' ########## ',
		'            ',
		'############',
		'            ',
	],
	day: [
		'     ##     ',
		' #   ##   # ',
		'  #      #  ',
		'    ####    ',
		'   ######   ',
		'## ###### ##',
		'## ###### ##',
		'   ######   ',
		'    ####    ',
		'  #      #  ',
		' #   ##   # ',
		'     ##     ',
	],
	sunset: [
		'            ',
		'            ',
		'    ####    ',
		'  ########  ',
		' ########## ',
		'            ',
		' ########## ',
		'############',
		'            ',
		'############',
		'            ',
		'############',
	],
	dusk: [
		'        #   ',
		'   ###     #',
		'  ##        ',
		' ##         ',
		' ##         ',
		' ##         ',
		' ###        ',
		'  ####  #   ',
		'   #####    ',
		'            ',
		'############',
		'            ',
	],
	night: [
		'         #  ',
		'    ###     ',
		'   ##     # ',
		'  ##        ',
		'  ##     #  ',
		'  ##        ',
		'  ###       ',
		'   #####    ',
		'    ###     ',
		'  #       # ',
		'            ',
		'      #     ',
	],
};

const CHECK = [
	'            ',
	'          ##',
	'         ## ',
	'        ##  ',
	' #     ##   ',
	' ##   ##    ',
	'  ## ##     ',
	'   ###      ',
	'    #       ',
];

const pixels = (grid: string[]) =>
	grid.flatMap((row, y) => [...row].flatMap((ch, x) => (ch === '#' ? [{ x, y }] : [])));

const OPTIONS = [
	{ value: 'auto', label: 'Automatic' },
	{ value: 'off', label: 'Off' },
	{ value: 'predawn', label: 'Pre-dawn' },
	{ value: 'sunrise', label: 'Sunrise' },
	{ value: 'day', label: 'Daytime' },
	{ value: 'sunset', label: 'Sunset' },
	{ value: 'dusk', label: 'Dusk' },
	{ value: 'night', label: 'Night' },
];
---

<div class="theme" data-theme-menu>
	<button
		class="theme-button"
		type="button"
		aria-haspopup="menu"
		aria-expanded="false"
		aria-controls="theme-list"
		aria-label="Time of day theme"
		data-theme-button
	>
		{
			Object.entries(ICONS).map(([name, grid]) => (
				<svg class="icon" data-icon={name} viewBox="0 0 12 12" width="18" height="18" aria-hidden="true">
					{pixels(grid).map(({ x, y }) => <rect x={x} y={y} width="1" height="1" />)}
				</svg>
			))
		}
	</button>

	<ul class="theme-list" id="theme-list" role="menu" aria-label="Time of day" hidden data-theme-list>
		{
			OPTIONS.map(({ value, label }, i) => (
				<>
					{i === 2 && <li class="divider" role="separator" />}
					<li role="none">
						<button type="button" role="menuitemradio" aria-checked="false" data-value={value} tabindex="-1">
							<svg class="icon" viewBox="0 0 12 12" width="14" height="14" aria-hidden="true">
								{pixels(ICONS[value]).map(({ x, y }) => <rect x={x} y={y} width="1" height="1" />)}
							</svg>
							<span>{label}</span>
							<svg class="check" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
								{pixels(CHECK).map(({ x, y }) => <rect x={x} y={y} width="1" height="1" />)}
							</svg>
						</button>
					</li>
				</>
			))
		}
	</ul>
</div>

<style>
	/* The dropdown is anchored to the nav's button + clock group (.right in Nav). */
	.theme {
		position: static;
	}

	.icon,
	.check {
		fill: currentColor;
		shape-rendering: crispEdges;
	}

	/* A soft rounded square, always visible; a touch darker on hover / while open. */
	.theme-button {
		display: grid;
		place-items: center;
		/* Same height as the clock block ("Seattle" + time), top and bottom lined up. */
		width: 46px;
		height: 46px;
		margin-top: 4.5px;
		padding: 0;
		border: 0;
		border-radius: 12px;
		background: color-mix(in srgb, var(--color-text) 9%, transparent);
		color: var(--color-heading);
		cursor: pointer;
		transition: background-color 0.2s ease;
	}

	.theme-button:hover,
	.theme-button[aria-expanded='true'] {
		background: color-mix(in srgb, var(--color-text) 15%, transparent);
	}

	.theme-button:focus-visible,
	.theme-list button:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	/* Only the icon for the phase on screen is shown. */
	.theme-button .icon {
		display: none;
	}

	.theme-list {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		z-index: 10;
		min-width: 180px;
		margin: 0;
		padding: 6px;
		list-style: none;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background: var(--color-surface);
		box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
		font-size: 14px;
	}

	.theme-list[hidden] {
		display: none;
	}

	.theme-list button {
		display: flex;
		align-items: center;
		gap: 10px;
		width: 100%;
		padding: 8px 10px;
		border: 0;
		border-radius: 8px;
		background: none;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	.theme-list button:hover,
	.theme-list button:focus-visible {
		background: color-mix(in srgb, var(--color-text) 8%, transparent);
	}

	.theme-list span {
		flex: 1;
	}

	.check {
		visibility: hidden;
	}

	.theme-list [aria-checked='true'] .check {
		visibility: visible;
	}

	.divider {
		height: 1px;
		margin: 6px 4px;
		background: var(--color-border);
	}
</style>

<style is:global>
	/* The button shows the icon for the phase on screen (Off shows "off"). */
	:root[data-phase='predawn'] .theme-button svg.icon[data-icon='predawn'],
	:root[data-phase='sunrise'] .theme-button svg.icon[data-icon='sunrise'],
	:root[data-phase='day'] .theme-button svg.icon[data-icon='day'],
	:root[data-phase='sunset'] .theme-button svg.icon[data-icon='sunset'],
	:root[data-phase='dusk'] .theme-button svg.icon[data-icon='dusk'],
	:root[data-phase='night'] .theme-button svg.icon[data-icon='night'],
	:root[data-phase='off'] .theme-button svg.icon[data-icon='off'] {
		display: block;
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>('[data-theme-menu]');

	if (root) {
		const button = root.querySelector<HTMLButtonElement>('[data-theme-button]')!;
		const list = root.querySelector<HTMLElement>('[data-theme-list]')!;
		const items = [...list.querySelectorAll<HTMLButtonElement>('[role="menuitemradio"]')];
		const sky = (window as any).__sky;

		const LABELS: Record<string, string> = {
			predawn: 'Pre-dawn',
			sunrise: 'Sunrise',
			day: 'Daytime',
			sunset: 'Sunset',
			dusk: 'Dusk',
			night: 'Night',
			off: 'Off',
		};

		// Reflect the saved choice (checkmark) and the phase on screen (label).
		function sync() {
			const choice = document.documentElement.dataset.themeChoice || 'auto';
			const phase = document.documentElement.dataset.phase || 'day';
			items.forEach((item) => item.setAttribute('aria-checked', String(item.dataset.value === choice)));
			button.setAttribute(
				'aria-label',
				`Time of day theme: ${choice === 'auto' ? `Automatic (${LABELS[phase]})` : LABELS[phase]}`,
			);
		}

		function open(focusIndex?: number) {
			list.hidden = false;
			button.setAttribute('aria-expanded', 'true');
			const checked = items.findIndex((i) => i.getAttribute('aria-checked') === 'true');
			items[focusIndex ?? Math.max(0, checked)].focus();
		}

		function close(returnFocus = true) {
			if (list.hidden) return;
			list.hidden = true;
			button.setAttribute('aria-expanded', 'false');
			if (returnFocus) button.focus();
		}

		button.addEventListener('click', () => (list.hidden ? open() : close()));
		button.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
				e.preventDefault();
				open(e.key === 'ArrowUp' ? items.length - 1 : 0);
			}
		});

		items.forEach((item, i) => {
			item.addEventListener('click', () => {
				sky?.setChoice(item.dataset.value);
				sync();
				close();
			});
			item.addEventListener('keydown', (e) => {
				const move = (to: number) => {
					e.preventDefault();
					items[(to + items.length) % items.length].focus();
				};
				if (e.key === 'ArrowDown') move(i + 1);
				else if (e.key === 'ArrowUp') move(i - 1);
				else if (e.key === 'Home') move(0);
				else if (e.key === 'End') move(items.length - 1);
				else if (e.key === 'Escape') close();
				else if (e.key === 'Tab') close(false);
			});
		});

		document.addEventListener('click', (e) => {
			if (!root.contains(e.target as Node)) close(false);
		});

		// Automatic can change phase while the page is open.
		new MutationObserver(sync).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-phase', 'data-theme-choice'],
		});
		sync();
	}
</script>
