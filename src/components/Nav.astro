---
const links = [
	{ label: 'Work', href: '/' },
	{ label: 'About', href: '/about' },
	{
		label: 'Resume',
		href: 'https://drive.google.com/file/d/1kOM3oj4jShSANyLl8X3gvEBGiuSP5gpV/view?usp=sharing',
		external: true,
	},
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav container">
	<a href="/" class="name">Camilla Delgado</a>

	<nav id="main-nav" aria-label="Main">
		<ul>
			{
				links.map(({ label, href, external }) => (
					<li>
						<a
							href={href}
							aria-current={path === href ? 'page' : undefined}
							{...(external && { target: '_blank', rel: 'noopener' })}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<div class="time">
		<span>Seattle</span>
		<time class="muted clock" data-clock>Local time</time>
	</div>

	<button
		class="menu-button"
		type="button"
		aria-controls="main-nav"
		aria-expanded="false"
		aria-label="Menu"
		data-menu-button
	>
		<span></span>
		<span></span>
	</button>
</header>

<script>
	// Live Seattle time, e.g. "12:25 PM". Runs in the browser, so the
	// "Local time" fallback only shows if JavaScript is off.
	const format = new Intl.DateTimeFormat('en-US', {
		timeZone: 'America/Los_Angeles',
		hour: 'numeric',
		minute: '2-digit',
	});

	const clocks = document.querySelectorAll<HTMLTimeElement>('[data-clock]');

	function tick() {
		const now = new Date();
		const text = format.format(now);
		clocks.forEach((el) => {
			if (el.textContent === text) return; // only touch the page when the minute changes
			el.textContent = text;
			el.dateTime = now.toISOString();
		});
	}

	// Checks every second so the minute flips on time.
	tick();
	setInterval(tick, 1000);

	// Phone menu: the button toggles the links open and closed.
	const header = document.querySelector<HTMLElement>('.nav');
	const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');

	function setOpen(open: boolean) {
		header?.classList.toggle('is-open', open);
		button?.setAttribute('aria-expanded', String(open));
	}

	button?.addEventListener('click', () => {
		setOpen(button.getAttribute('aria-expanded') !== 'true');
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') setOpen(false);
	});
</script>

<style>
	.nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: start;
		padding-top: 24px;
		font-size: 16px;
		line-height: 1.3;
	}

	ul {
		display: flex;
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Every link is pill-shaped; the pill only shows on hover. */
	nav a {
		display: block;
		padding: 4px 8px;
		border: 1px solid transparent;
		border-radius: 16px;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease;
	}

	nav a:hover {
		background: var(--color-surface);
		border-color: var(--color-border);
	}

	nav a:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	/* Match the links' pill padding + border so all first lines sit on one row. */
	.name,
	.time {
		padding-top: 5px;
	}

	.time {
		display: flex;
		flex-direction: column;
		gap: 4px;
		justify-self: end;
	}

	/* Equal-width digits so the clock doesn't jiggle as the time changes. */
	.clock {
		font-variant-numeric: tabular-nums;
	}

	/* Only shown on phones (see below). */
	.menu-button {
		display: none;
	}

	@media (max-width: 640px) {
		.nav {
			grid-template-columns: 1fr auto auto;
			column-gap: 20px;
		}

		.menu-button {
			display: flex;
			flex-direction: column;
			justify-content: center;
			gap: 6px;
			width: 36px;
			height: 36px;
			margin-right: -8px;
			padding: 8px;
			border: 0;
			background: none;
			color: inherit;
			cursor: pointer;
		}

		/* Two lines that turn into an X when the menu is open. */
		.menu-button span {
			display: block;
			height: 1.5px;
			background: currentColor;
			transition: transform 0.2s ease;
		}

		.is-open .menu-button span:first-child {
			transform: translateY(3.75px) rotate(45deg);
		}

		.is-open .menu-button span:last-child {
			transform: translateY(-3.75px) rotate(-45deg);
		}

		.menu-button:focus-visible {
			outline: 2px solid var(--color-accent);
			outline-offset: 2px;
			border-radius: 8px;
		}

		nav {
			display: none;
			grid-column: 1 / -1;
			grid-row: 2;
			padding-top: 24px;
		}

		.is-open nav {
			display: block;
		}

		ul {
			flex-direction: column;
			gap: 8px;
			margin-left: -8px;
			font-size: 24px;
		}

		nav a {
			display: inline-block;
		}
	}
</style>
