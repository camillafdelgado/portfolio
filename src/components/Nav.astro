---
const links = [
	{ label: 'Work', href: '/' },
	{ label: 'About', href: '/about' },
	{
		label: 'Resume',
		href: 'https://drive.google.com/file/d/1kOM3oj4jShSANyLl8X3gvEBGiuSP5gpV/view?usp=sharing',
		external: true,
	},
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav container">
	<a href="/" class="name">Camilla Delgado</a>

	<nav aria-label="Main">
		<ul>
			{
				links.map(({ label, href, external }) => (
					<li>
						<a
							href={href}
							aria-current={path === href ? 'page' : undefined}
							{...(external && { target: '_blank', rel: 'noopener' })}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<div class="time">
		<span>Seattle</span>
		<span class="muted">Local time</span>
	</div>
</header>

<style>
	.nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: start;
		padding-top: 24px;
		font-size: 16px;
		line-height: 1.3;
	}

	ul {
		display: flex;
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Every link is pill-shaped; the pill only shows on hover. */
	nav a {
		display: block;
		padding: 4px 8px;
		border: 1px solid transparent;
		border-radius: 16px;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease;
	}

	nav a:hover {
		background: var(--color-surface);
		border-color: var(--color-border);
	}

	nav a:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	/* Match the links' pill padding + border so all first lines sit on one row. */
	.name,
	.time {
		padding-top: 5px;
	}

	.time {
		display: flex;
		flex-direction: column;
		gap: 4px;
		justify-self: end;
	}

	@media (max-width: 640px) {
		.nav {
			grid-template-columns: 1fr auto;
			row-gap: 12px;
		}
		nav {
			grid-column: 1 / -1;
			grid-row: 2;
		}
		ul {
			margin-left: -8px;
		}
	}
</style>
